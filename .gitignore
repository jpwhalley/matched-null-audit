# Environments
.venv/
__pycache__/
*.pyc

# Large regenerable intermediates
# Bulk caches stay out. The matched-control draws are the evidentiary
# basis for the deletion nulls and are released with the paper.
cache/*
!cache/E2_matched_controls_*.json
# Per-draw gene listings are written for local inspection but are read
# by nothing; the compact draw files are what reproduce the nulls.
cache/*_detail.json
outputs/E2_baseline_embs_*.npy
outputs/E1_esm2_embeddings.npy

# Model checkpoints are not redistributed (see DATA_MANIFEST.md)
Geneformer/
models/
*.pt
*.bin
*.safetensors

# Single-cell data downloaded by the D-series
*.h5ad

# OS / editor
.DS_Store
.ipynb_checkpoints/

# Google Drive sync-conflict duplicates. These are superseded copies with a
# numeric suffix; they must never be committed, and `git add -A` would sweep
# them in silently.
*([0-9]).*
* [0-9].*
*conflicted copy*

# Google Drive conflict copies: stale duplicates, one of them a whole second
# .git directory. Committing them would add ~35 MB of junk.
*" (1)"/
* (1)/
